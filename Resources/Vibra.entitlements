<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Vibra runs arbitrary user commands in a PTY, so it cannot be sandboxed.

  Everything below exists because macOS attributes a child process' TCC
  prompt to the app that spawned it: a command run inside a Vibra terminal
  asks for the camera, the address book or Apple events as Vibra, and is
  denied outright unless Vibra declares the capability.

  Deliberately absent:
    - com.apple.security.app-sandbox: forking a login shell is not permitted
      inside the sandbox.
    - com.apple.security.cs.disable-library-validation: the Rust binary loads
      no non-system dynamic libraries.
    - com.apple.security.cs.allow-jit and allow-unsigned-executable-memory:
      nothing in the app generates executable memory at runtime.
  Add these only alongside a change that actually needs them.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
